# -------------------- Geometry utility functions (API-independent) --------------------

def _haversine(lon1, lat1, lon2, lat2):
    """Calculate the great-circle distance between two points in km."""
    lon1, lat1, lon2, lat2 = map(radians, [lon1, lat1, lon2, lat2])
    dlon = lon2 - lon1
    dlat = lat2 - lat1
    a = sin(dlat / 2) ** 2 + cos(lat1) * cos(lat2) * sin(dlon / 2) ** 2
    c = 2 * asin(sqrt(a))
    return 6371 * c # Earth radius


def _polygon_centroid(coords):
    """
    Calculate the centroid of a polygon with a closed coordinate list.
    coords: [(lat, lng), ...] or [(lng, lat), ...]; the format must be consistent.
    """
    n = len(coords) - 1  # Exclude the repeated closing point.
    if n < 3:
        raise ValueError("A polygon must have at least 3 vertices")

    # Use the Shoelace formula to compute the polygon centroid.
    points_rad = [(radians(lat), radians(lng)) for lat, lng in coords[:n]]

    area = 0
    cx = 0
    cy = 0

    for i in range(n):
        j = (i + 1) % n
        lat_i, lng_i = points_rad[i]
        lat_j, lng_j = points_rad[j]
        cross = lat_i * lng_j - lat_j * lng_i
        area += cross
        cx += (lat_i + lat_j) * cross
        cy += (lng_i + lng_j) * cross

    area /= 2
    if abs(area) < 1e-12:
        # Fall back to a simple average when the area is too small.
        avg_lat = sum(lat for lat, _ in coords[:n]) / n
        avg_lng = sum(lng for _, lng in coords[:n]) / n
        return (avg_lat, avg_lng)

    cx = cx / (6 * area)
    cy = cy / (6 * area)

    # Convert back to degrees.
    return (degrees(cx), degrees(cy))


def _point_in_polygon(point, polygon):
    """
    Use the ray-casting algorithm to check whether a point lies inside a polygon.
    point: (lat, lng)
    polygon: [(lat, lng), ...] closed loop
    """
    lat, lng = point
    n = len(polygon) - 1  # Actual vertex count.
    inside = False
    j = n - 1
    for i in range(n):
        lat_i, lng_i = polygon[i]
        lat_j, lng_j = polygon[j]
        if ((lng_i > lng) != (lng_j > lng)) and \
           (lat < (lat_j - lat_i) * (lng - lng_i) / (lng_j - lng_i) + lat_i):
            inside = not inside
        j = i
    return inside


# -------------------- Isochrone API calls --------------------

ISOCHRONE_API_URL = os.getenv("GOOGLE_ISOCHORNE_API_URL")


def preProcess(user_enters: list) -> list:
    """
    Preprocess user-entered addresses into standardized place objects with coordinates and place_id.
    First use Places Autocomplete to get the best match, then use Place Details to fetch coordinates.
    Returns a list of dicts containing 'formatted_address', 'lat', 'lng', and 'place_id'.
    """
    enter_list = []
    for address in user_enters:
        try:
            # Step 1: Use Places Autocomplete to get the best matching place_id.
            autocomplete_result = gmaps.places_autocomplete(address)
            if not autocomplete_result:
                print(f"Warning: address '{address}' could not be matched by Autocomplete.")
                return None

            # Take the place_id from the first match.
            best_match = autocomplete_result[0]
            place_id = best_match['place_id']

            # Step 2: Use place_id to fetch precise coordinates via Place Details.
            place_details = gmaps.place(place_id, fields=['geometry', 'formatted_address'])
            result = place_details.get('result', {})
            if not result:
                print(f"Warning: could not retrieve details for place_id '{place_id}'.")
                return None

            lat = result['geometry']['location']['lat']
            lng = result['geometry']['location']['lng']

            enter_list.append({
                'formatted_address': result.get('formatted_address', best_match.get('description', address)),
                'lat': lat,
                'lng': lng,
                'place_id': place_id
            })
        except Exception as e:
            print(f"preProcess error: {e}")
            return None

    return enter_list


def getIsochrone(start_point: dict, method: str,
                 travel_time: str = "30m") -> dict:
    """
    Call the Google Routes API computeIsochrone endpoint to get an isochrone polygon.
    Args:
        start_point: Location dict returned by preProcess (must include 'place_id' or 'lat'/'lng').
        method: Travel mode; one of 'DRIVE', 'TRANSIT', 'WALK', 'BICYCLE', 'TWO_WHEELER'.
        travel_time: Isochrone time threshold such as "30m" or "1h".
    Returns:
        {
            'origin': (lat, lng),
            'method': str,
            'travel_time': str,
            'polygon_coords': [(lat, lng), ...],
            'centroid': (lat, lng),
            'radius_km': float
        }
    """
    # Validate the travel mode.
    valid_methods = ['DRIVE', 'TRANSIT', 'WALK', 'BICYCLE', 'TWO_WHEELER']
    if method.upper() not in valid_methods:
        raise ValueError(f"Travel mode must be one of {valid_methods}; got: {method}")

    # Build the request payload.
    origin = {}
    if start_point.get('place_id'):
        origin['placeId'] = start_point['place_id']
    else:
        origin['address'] = f"{start_point['lat']},{start_point['lng']}"

    payload = {
        "origin": origin,
        "travelMode": method.upper(),
        "travelTime": travel_time,
        "polylineEncoding": "GEOJSON_LINESTRING"
    }

    headers = {
        "Content-Type": "application/json",
        "X-Goog-Api-Key": API_KEY,
        "X-Goog-FieldMask": "routes.isochronePolyline"
    }

    try:
        response = requests.post(ISOCHRONE_API_URL, json=payload, headers=headers)
        response.raise_for_status()
        data = response.json()
    except requests.exceptions.RequestException as e:
        raise RuntimeError(f"Isochrone API request failed: {e}")
    except json.JSONDecodeError:
        raise RuntimeError("Isochrone API returned a non-JSON response")

    # Parse the response.
    routes = data.get('routes', [])
    if not routes:
        raise RuntimeError(f"Isochrone API returned no results ({travel_time} / {method})")

    isochrone = routes[0].get('isochronePolyline', {})
    geojson = isochrone.get('geojsonLinestring', {})
    coords_lng_lat = geojson.get('coordinates', [])

    if not coords_lng_lat:
        raise RuntimeError("Isochrone API response contained no coordinate data")

    # Convert to (lat, lng) format.
    polygon_coords = [(lat, lng) for lng, lat in coords_lng_lat]

    # Ensure the polygon is closed.
    if polygon_coords[0] != polygon_coords[-1]:
        polygon_coords.append(polygon_coords[0])

    # Compute the centroid.
    centroid = _polygon_centroid(polygon_coords)

    # Compute an approximate radius as the farthest distance to the centroid.
    max_dist = 0
    for lat, lng in polygon_coords[:-1]:  # Skip the repeated closing point.
        d = _haversine(centroid[1], centroid[0], lng, lat)
        if d > max_dist:
            max_dist = d

    return {
        'origin': (start_point['lat'], start_point['lng']),
        'method': method.upper(),
        'travel_time': travel_time,
        'polygon_coords': polygon_coords,
        'centroid': centroid,
        'radius_km': max_dist
    }


def getCommon(isochrones: list) -> dict:
    """
    Compute the intersection area of all isochrones using a simple grid-sampling approach.
    Args:
        isochrones: List of results returned by getIsochrone.
    Returns:
        {
            'intersection_centroid': (lat, lng),
            'intersection_radius_km': float,
            'intersection_valid': bool,
            'intersection_polygons': [polygon_coords, ...],
            'combined_methods': list
        }
    """
    if not isochrones:
        return {'intersection_valid': False}

    # Collect all polygons and travel modes.
    polygons = [iso['polygon_coords'] for iso in isochrones]
    methods = [iso['method'] for iso in isochrones]

    # ---- Approximate intersection using grid sampling ----
    # 1. Determine the bounding box for all polygons.
    all_lats = []
    all_lngs = []
    for poly in polygons:
        for lat, lng in poly:
            all_lats.append(lat)
            all_lngs.append(lng)

    min_lat, max_lat = min(all_lats), max(all_lats)
    min_lng, max_lng = min(all_lngs), max(all_lngs)

    # 2. Sample uniformly within the bounding box and test whether each point lies inside every polygon.
    # Sampling density: about a 50x50 grid.
    grid_size = os.getenv("GRID_SIZE")
    step_lat = (max_lat - min_lat) / grid_size if grid_size > 0 else 0.001
    step_lng = (max_lng - min_lng) / grid_size if grid_size > 0 else 0.001

    intersection_points = []

    for i in range(grid_size + 1):
        lat = min_lat + i * step_lat
        for j in range(grid_size + 1):
            lng = min_lng + j * step_lng
            point = (lat, lng)

            # Check whether this point lies inside every polygon.
            in_all = True
            for poly in polygons:
                if not _point_in_polygon(point, poly):
                    in_all = False
                    break

            if in_all:
                intersection_points.append(point)

    if not intersection_points:
        return {
            'intersection_valid': False,
            'intersection_polygons': polygons,
            'combined_methods': list(set(methods))
        }

    # 3. Compute the centroid of the intersection points.
    cent_lat = sum(p[0] for p in intersection_points) / len(intersection_points)
    cent_lng = sum(p[1] for p in intersection_points) / len(intersection_points)
    centroid = (cent_lat, cent_lng)

    # 4. Compute the coverage radius as the distance to the farthest intersection point.
    max_dist = 0
    for lat, lng in intersection_points:
        d = _haversine(centroid[1], centroid[0], lng, lat)
        if d > max_dist:
            max_dist = d

    return {
        'intersection_centroid': centroid,
        'intersection_radius_km': max_dist,
        'intersection_valid': True,
        'intersection_point_count': len(intersection_points),
        'intersection_polygons': polygons,
        'combined_methods': list(set(methods))
    }


def getSuggestions(isochrones: list, placetype: str,
                   requires: dict = None,
                   max_pages: int = 1) -> list: #Google api returns sorted list by prominence
    """
    Search for POIs matching the given criteria within the common intersection area of all isochrones.
    Args:
        isochrones: List of results returned by getIsochrone.
        placetype: POI type such as 'restaurant', 'cafe', or 'park'.
        requires: Optional requirements dict, which may include:
            - 'keyword': str
            - 'min_rating': float
            - 'open_now': bool
    Returns:
        A list of POI dicts containing fields such as name, address, lat, lng, rating, and travel_times.
    """
    MAX_RADIUS = os.getenv("MAX_RADIUS")
    MIN_RADIUS = os.getenv("MIN_RADIUS")
    if requires is None:
        requires = {}

    keyword = requires.get('keyword', '')
    min_rating = requires.get('min_rating', 0.0)
    open_now = requires.get('open_now', False)

    # 1. Compute the intersection area.
    common = getCommon(isochrones)
    if not common['intersection_valid']:
        print("Warning: no common intersection area was found, so no places can be recommended.")
        return []

    center_lat, center_lng = common['intersection_centroid']
    radius_m = min(common['intersection_radius_km'] * 1000, MAX_RADIUS)  # Convert to meters, capped at 50 km.
    polygons = common['intersection_polygons']

    # 2. Use Places API to search within the enclosing circle of the intersection.
    location = (center_lat, center_lng)
    search_radius = max(int(radius_m), MIN_RADIUS)  # Minimum search radius is 100 m.

    try:
        response = gmaps.places_nearby(
            location=location,
            radius=search_radius,
            type=placetype,
            keyword=keyword if keyword else None,
            open_now=open_now if open_now else None
        )
    except Exception as e:
        print(f"Places API search failed: {e}")
        return []

    candidates = response.get('results', [])
    if not candidates:
        return []
    if max_pages <= 1:
        pass 
    else:
        # get more pages
        import time
        page_count = 1
        while 'next_page_token' in response and page_count < max_pages:
            time.sleep(2)
            try:
                response = gmaps.places_nearby(page_token=response['next_page_token'])
                candidates.extend(response.get('results', []))
                page_count += 1
            except Exception as e:
                print(f"Warning: failed to fetch page {page_count + 1}: {e}")
                break
    # 3. Check each candidate to ensure it truly lies inside the intersection (precise filtering).
    filtered = []
    for poi in candidates:
        poi_lat = poi['geometry']['location']['lat']
        poi_lng = poi['geometry']['location']['lng']
        poi_point = (poi_lat, poi_lng)

        # Check whether the point lies inside every isochrone polygon.
        in_all = True
        for poly in polygons:
            if not _point_in_polygon(poi_point, poly):
                in_all = False
                break

        if not in_all:
            continue

        # Check the rating threshold.
        rating = poi.get('rating', 0) or 0
        if rating < min_rating:
            continue

        # Compute travel times from each origin using Distance Matrix.
        origins = [(iso['origin'][0], iso['origin'][1]) for iso in isochrones]
        methods_for_matrix = [iso['method'] for iso in isochrones]

        travel_times = {}
        for idx, (origin, method) in enumerate(zip(origins, methods_for_matrix)):
            try:
                matrix = gmaps.distance_matrix(
                    origins=[origin],
                    destinations=[(poi_lat, poi_lng)],
                    mode=method.lower(),
                    units='metric'
                )
                element = matrix['rows'][0]['elements'][0]
                if element['status'] == 'OK':
                    travel_times[f"person_{idx}_{method}"] = element['duration']['value'] / 60.0  # Minutes
                else:
                    travel_times[f"person_{idx}_{method}"] = float('inf')
            except Exception:
                travel_times[f"person_{idx}_{method}"] = float('inf')

        # Compute the average travel time.
        valid_times = [v for v in travel_times.values() if v != float('inf')]
        avg_time = np.mean(valid_times) if valid_times else float('inf')

        filtered.append({
            'name': poi.get('name', 'Unknown'),
            'address': poi.get('vicinity', ''),
            'lat': poi_lat,
            'lng': poi_lng,
            'place_id': poi.get('place_id', ''),
            'rating': rating,
            'user_ratings_total': poi.get('user_ratings_total', 0),
            'travel_times': travel_times,
            'avg_travel_time': avg_time,
            'types': poi.get('types', [])
        })

    return filtered


def sortPlaces(suggestions: list) -> list:
    """
    Sort candidate POIs.
    Rules:
        1. Ascending average travel time (closer is better)
        2. Descending Google rating (higher is better)
        3. Descending review count (more reviews is more reliable)
    """
    def sort_key(poi):
        avg_time = poi.get('avg_travel_time', float('inf'))
        rating = poi.get('rating', 0) or 0
        total = poi.get('user_ratings_total', 0) or 0
        # Shorter travel time first, then higher rating, then more reviews.
        return (avg_time, -rating, -total)

    return sorted(suggestions, key=sort_key)


def queryAI(suggestions: list, amount: int = 5) -> str:
    """
    Format the sorted candidate POIs into structured text for LLM decision-making.
    Returns a string that can be injected directly into an LLM prompt.
    """
    if not suggestions:
        return "[No recommendations] No matching places were found within the common intersection of everyone's isochrones. " + \
                "Suggestion: expand the search time range or try a different place type."

    lines = [
        "Below are the recommended meeting places, ranked by isochrone intersection and ratings:",
        "=" * 60
    ]

    for i, poi in enumerate(suggestions, 1):
        name = poi.get('name', 'Unknown')
        addr = poi.get('address', 'No address')
        rating = poi.get('rating', 'No rating')
        avg_time = poi.get('avg_travel_time', float('inf'))

        # Travel time details for each participant.
        travel_details = []
        for key, value in poi.get('travel_times', {}).items():
            if value != float('inf'):
                # Extract information from keys such as "person_0_DRIVE".
                parts = key.split('_')
                if len(parts) >= 3:
                    person_idx = parts[1]
                    method = '_'.join(parts[2:])
                    travel_details.append(f"  Participant {person_idx} ({method}): {value:.1f} min")
                else:
                    travel_details.append(f"  {key}: {value:.1f} min")

        lines.append(f"\n{i}. {name}")
        lines.append(f"   Address: {addr}")
        lines.append(f"   Rating: {rating} ({poi.get('user_ratings_total', 0)} reviews)")
        lines.append(f"   Average travel time: {avg_time:.1f} min")
        if travel_details:
            lines.append("   Individual travel times:")
            display_count = max(0, amount)         
            lines.extend(travel_details[:display_count]) 

    lines.append("\n" + "=" * 60)
    lines.append("Please choose the best meeting place based on convenience, ratings, and user preferences.")
    lines.append("If you want to search again, for example by adjusting the time threshold, place type, or keyword, let me know.")

    return "\n".join(lines)


# -------------------- Advanced features: iterative control --------------------

def adjustTimeThreshold(isochrones: list, new_time: str) -> list:
    """
    Adjust the isochrone time threshold and fetch new isochrones for iterative backtracking.
    Args:
        isochrones: Original getIsochrone result list.
        new_time: New time threshold such as "45m" or "1h".
    Returns:
        A new list of isochrones.
    """
    new_isochrones = []
    for iso in isochrones:
        # Rebuild the start_point dict from the original origin.
        start_point = {
            'lat': iso['origin'][0],
            'lng': iso['origin'][1],
            'place_id': None  # Use coordinates if place_id was not preserved.
        }
        # Try to recover place_id from the saved isochrone if it exists.
        new_iso = getIsochrone(start_point, iso['method'], new_time)
        new_isochrones.append(new_iso)
    return new_isochrones


def full_pipeline(user_addresses: list, transport_modes: list,
                  place_type: str, travel_time: str = "30m",
                  requirements: dict = None) -> dict:
    """
    Run the full workflow in one call: preprocess → isochrones → intersection → POI search → sort → AI text.
    Returns a dict containing all intermediate results for flexible downstream use.
    """
    # 1. Preprocess.
    processed = preProcess(user_addresses)
    if processed is None:
        return {"error": "Address parsing failed; please check the input.", "stage": "preProcess"}

    # 2. Get isochrones.
    isochrones = []
    for point, mode in zip(processed, transport_modes):
        try:
            iso = getIsochrone(point, mode, travel_time)
            isochrones.append(iso)
        except Exception as e:
            return {"error": f"Isochrone retrieval failed: {e}", "stage": "getIsochrone"}

    # 3. Compute the intersection.
    common = getCommon(isochrones)
    if not common['intersection_valid']:
        return {
            "error": "The participants' isochrones do not overlap; consider increasing the time threshold.",
            "stage": "getCommon",
            "isochrones": isochrones,
            "common": common
        }

    # 4. Search POIs.
    suggestions = getSuggestions(isochrones, place_type, requirements)

    # 5. Sort.
    sorted_places = sortPlaces(suggestions)

    # 6. Generate AI text.
    ai_text = queryAI(sorted_places)

    return {
        "stage": "complete",
        "processed_addresses": processed,
        "isochrones": isochrones,
        "common_area": common,
        "suggestions": sorted_places,
        "ai_text": ai_text,
        "suggestions_count": len(sorted_places)
    }


